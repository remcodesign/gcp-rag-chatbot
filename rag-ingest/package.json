{
  "name": "rag-ingest",
  "version": "0.1.0",
  "description": "One-time, idempotent Northwind Outfitters corpus seeder (Cloud Run Job) — 100% strict TypeScript",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist",
    "start": "node dist/src/cli.js"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.0",
    "typescript": "5.9.3",
    "vitest": "^2.1.9"
  }
}
