{
  "name": "rag-api",
  "version": "0.1.0",
  "description": "Streaming RAG backend — stateless session/event state on Cloud Firestore",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"lib/**/*.ts\" \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"lib/**/*.ts\" \"src/**/*.ts\" \"test/**/*.ts\"",
    "knip": "knip",
    "clean": "rm -rf dist",
    "start": "node dist/src/server.js"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "@openrouter/sdk": "^1.2.67"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.32.3",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "vitest": "^2.1.9"
  }
}
