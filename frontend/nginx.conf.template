# nginx server block for the static Vue 3 chat frontend (rag-frontend).
# The Dockerfile CMD runs envsubst, substituting ${PORT} into this template to
# produce /etc/nginx/conf.d/default.conf. Cloud Run injects $PORT at deploy
# time; the Dockerfile sets PORT=8080 as a default for local runs.

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # The BFF (rag-bff) scales to zero, so its IP changes. nginx caches the
    # upstream IP at startup; without a resolver it goes stale -> 503. Use
    # Google's DNS and re-resolve so the BFF hostname is always current.
    resolver 8.8.8.8 valid=10s ipv6=off;

    # The browser sends a large GAESA cookie (Google auth). nginx's default
    # large_client_header_buffers (4x8k) can be exceeded, causing a 400
    # "request header or cookie too large". Raise it generously so the large
    # cookie fits (8 buffers of 32k = 256k total).
    large_client_header_buffers 8 32k;

    # SPA fallback: any non-asset path serves index.html so refreshes/deep links work.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Vite emits hashed, immutable asset filenames — cache hard.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # The UI calls the BFF (rag-bff) on the SAME origin. nginx proxies
    # /sessions/* to the BFF, which rate-limits and forwards to the private
    # rag-api. No CORS is needed between the frontend and the BFF (same-origin).
    location /sessions/ {
        # Use a variable so nginx re-resolves the BFF hostname per-request
        # (the BFF scales to zero, so its IP changes).
        set $bff ${BFF_URL};
        proxy_pass $bff;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE: keep the upstream connection alive (without this nginx may
        # downgrade to HTTP/1.0 and close the connection, truncating the stream).
        proxy_set_header Connection '';
        # nginx's default proxy_buffer_size (4k) is too small for the BFF's
        # response header block (Cloud Run's edge adds a large GAESA cookie),
        # causing "upstream sent too big header" -> 502. Raise it generously.
        proxy_buffer_size 64k;
        proxy_buffers 4 64k;
        # Cloud Run's edge adds a large GAESA Set-Cookie to every response;
        # the frontend doesn't need it, so strip it from the client response.
        proxy_hide_header Set-Cookie;
        # SSE: disable buffering so frames stream through.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    # POC: the sidebar polls the BFF's /limits/:sessionId endpoint (rate-limit
    # usage). Proxy it to the BFF too, so the frontend stays same-origin.
    location /limits/ {
        # Use a variable so nginx re-resolves the BFF hostname per-request
        # (the BFF scales to zero, so its IP changes).
        set $bff ${BFF_URL};
        proxy_pass $bff;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The BFF scales to zero; give it time to cold-start and respond.
        proxy_read_timeout 300s;
        # Cloud Run's edge adds a large GAESA cookie to the response header;
        # raise the buffer so it doesn't trigger "too big header" -> 502.
        proxy_buffer_size 64k;
        proxy_buffers 4 64k;
        # Cloud Run's edge adds a large GAESA Set-Cookie to every response;
        # the frontend doesn't need it, so strip it from the client response.
        proxy_hide_header Set-Cookie;
    }
}