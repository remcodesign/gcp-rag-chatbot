# nginx server block for the static Vue 3 chat frontend (rag-frontend).
# The Dockerfile CMD runs envsubst, substituting ${PORT} into this template to
# produce /etc/nginx/conf.d/default.conf. Cloud Run injects $PORT at deploy
# time; the Dockerfile sets PORT=8080 as a default for local runs.

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback: any non-asset path serves index.html so refreshes/deep links work.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Vite emits hashed, immutable asset filenames — cache hard.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # The UI calls the BFF (rag-bff) on the SAME origin. nginx proxies
    # /sessions/* to the BFF, which rate-limits and forwards to the private
    # rag-api. No CORS is needed between the frontend and the BFF (same-origin).
    location /sessions/ {
        proxy_pass ${BFF_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE: keep the upstream connection alive (without this nginx may
        # downgrade to HTTP/1.0 and close the connection, truncating the stream).
        proxy_set_header Connection '';
        # nginx's default proxy_buffer_size (4k) is too small for the BFF's
        # response header block, causing "upstream sent too big header" -> 502.
        # Raise it so the SSE response headers fit.
        proxy_buffer_size 16k;
        proxy_buffers 4 16k;
        # SSE: disable buffering so frames stream through.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    # POC: the sidebar polls the BFF's /limits/:sessionId endpoint (rate-limit
    # usage). Proxy it to the BFF too, so the frontend stays same-origin.
    location /limits/ {
        proxy_pass ${BFF_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}