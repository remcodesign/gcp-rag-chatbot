{
  "name": "rag-frontend",
  "version": "0.1.0",
  "description": "Nuxt 3 streaming chat frontend (SSR + Nitro BFF) for the Northwind Outfitters RAG demo",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.vue\" \"server/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"src/**/*.vue\" \"server/**/*.ts\" \"test/**/*.ts\"",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "h3": "^1.15.11",
    "marked": "^18.0.10",
    "nuxt": "^3.17.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.9.0",
    "jsdom": "^29.1.1",
    "knip": "^6.32.3",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^2.2.0"
  }
}
