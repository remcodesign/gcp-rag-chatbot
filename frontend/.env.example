# Local development environment for the Nuxt frontend (Nitro BFF).
#
# Copy this file to `frontend/.env` and adjust for your machine. `.env` is
# git-ignored (see root `.gitignore`); only this `.env.example` is committed.
#
# The Nitro BFF proxies `POST /api/sessions/:id/messages` to rag-api
# server-to-server. On Cloud Run, `RAG_API_BASE` is set by Terraform
# (infra/cloud_run.tf) and the BFF mints an OIDC token from the metadata
# server. Locally, point it at a locally-running rag-api (no IAM, no token).

# The private rag-api base URL the Nitro server proxies to.
# Local rag-api: `cd rag-api && npm run build && npm start` (listens on :8080).
RAG_API_BASE=http://localhost:8080

# Rate-limit knobs (per client IP + per session) for the Nitro BFF.
RATE_WINDOW_MS=60000
RATE_MAX_PER_IP=20
RATE_MAX_PER_SESSION=10
